APP_NAME="Game Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis connections remain configured as a future reserve.
# The Redis container is not started by default (`docker compose --profile future up redis`).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:5173

RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_DRIVER=ollama
RAG_INDEX_SYNC=true
# Host Ollama (GPU): http://host.docker.internal:11434 — docs/Development/Setup.md
# Docker Ollama (CPU, profile docker-ollama): http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_MAX_OUTPUT_TOKENS=3000
EXTRACTOR_DRIVER=ollama
# EXTRACTOR_OLLAMA_MODEL defaults to OLLAMA_CHAT_MODEL when unset
EXTRACTOR_TEMPERATURE=0.1
EXTRACTOR_MAX_OUTPUT_TOKENS=5000
EXTRACTOR_HTTP_TIMEOUT_SECONDS=300
# EXTRACTOR_THINK=false — reasoning off; JSON goes to content (default)
EXTRACTOR_SCENE_MESSAGE_LIMIT=30
EXTRACTOR_CATALOG_MAX_ENTITIES=150
CONTEXT_CHARACTERS_PER_TOKEN=3
CONTEXT_COPILOT_MAX_INPUT_TOKENS=12000
CONTEXT_TOPIC_MAX_INPUT_TOKENS=8000
COPILOT_HISTORY_LIMIT=30
COPILOT_TOPIC_HISTORY_LIMIT=8
COPILOT_TOPIC_MAX_OUTPUT_TOKENS=384
COPILOT_TOPIC_TEMPERATURE=0.2
COPILOT_TOOLS_ENABLED=true
COPILOT_TOOLS_MAX_ITERATIONS=2
COPILOT_TOOLS_SEARCH_LIMIT=5
COPILOT_TOOLS_RANGE_LIMIT=20
COPILOT_TOOLS_MAX_ITEM_CHARACTERS=400
COPILOT_TOOLS_MAX_RESULT_TOKENS=800
COPILOT_TOOLS_MAX_LOOP_TOKENS=2000
RETRIEVAL_STATEMENT_TIMEOUT_MS=2000

VITE_APP_NAME="${APP_NAME}"
